{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astralabs-ai.net/schemas/astra-ce-scenario-v1.json",
  "title": "Astra CE community scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "track",
    "difficulty",
    "frameworks",
    "estimated_minutes",
    "learning_objectives",
    "provenance",
    "stages"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "track": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64},
    "difficulty": {"enum": ["foundation", "practitioner", "expert"]},
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 64}
    },
    "practice_area": {"type": "string", "minLength": 1, "maxLength": 80},
    "estimated_minutes": {"type": "integer", "minimum": 1, "maximum": 180},
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "license"],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "license": {
          "enum": ["Apache-2.0", "CC-BY-4.0", "CC0-1.0"]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "source_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "agent_message", "demands", "choices"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "maxLength": 64},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 24},
        "agent_message": {"type": "string", "maxLength": 4000},
        "demands": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "choices": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/choice"}
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "consequence",
        "is_correct",
        "framework_rationale",
        "next_stage",
        "risk_outcome",
        "dimension_weights",
        "control_refs"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "maxLength": 64},
        "label": {"type": "string", "minLength": 1, "maxLength": 240},
        "consequence": {"type": "string", "minLength": 1, "maxLength": 2000},
        "is_correct": {"type": "boolean"},
        "framework_rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
        "next_stage": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "maxLength": 64},
            {"type": "null"}
          ]
        },
        "risk_outcome": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "maxLength": 64},
        "dimension_weights": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "judgment": {"type": "integer", "minimum": -10, "maximum": 10},
            "control_mapping": {"type": "integer", "minimum": -10, "maximum": 10},
            "evidence": {"type": "integer", "minimum": -10, "maximum": 10},
            "escalation": {"type": "integer", "minimum": -10, "maximum": 10}
          }
        },
        "control_refs": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()-]*$", "maxLength": 120}
        }
      }
    }
  }
}
