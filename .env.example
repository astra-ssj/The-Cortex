# ─────────────────────────────────────────────
# CORTEX Environment Variables
# Copy to .env and update before running
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_USER=cortex
POSTGRES_DB=cortex

# FastAPI
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# REQUIRED — the stack refuses to start without these (docker-compose uses :?).
# No insecure defaults are baked in: set your own values here for local dev and
# always override in staging/production. Do NOT commit real values (.env is gitignored).
# ─────────────────────────────────────────────
# JWT signing key. The API refuses to start without this: the built-in fallback
# key is committed to the repo, so it would let anyone forge a token for any org.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
CORTEX_LEGACY_DEMO_PASSWORD=
COMPLIANCE_ENGINE_STUB_PASSWORD=CHANGE_ME_STUB_PASSWORD
COMPLIANCE_ENGINE_STUB_ACCESS_TOKEN=CHANGE_ME_STUB_ACCESS_TOKEN

# GraphJin
GO_ENV=development

# Optional: Anthropic API (Epic 4 — DSPy)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Google Gemini API (Gemini 4 Argon with thinking_level & context caching)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-4-argon
# GEMINI_THINKING_LEVEL=high

# Optional: Production overrides
# DATABASE_URL=postgresql+asyncpg://cortex:password@db:5432/cortex
# API_HOST=0.0.0.0
# API_PORT=8000

# Frontend (Vite) — optional; use frontend/.env.local when running npm run dev
# Shows a deployment badge in the app shell (e.g. staging, prod-canary).
# VITE_CORTEX_DEPLOY_LABEL=staging

# Learning-loop agent (core/agents/model.py). No real keys here.
# MODEL_PROVIDER=anthropic|openai|gemini|ollama|stub
# Unset: Anthropic if ANTHROPIC_API_KEY is set, else stub (on main today).
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# AGENT_MODEL=gemma4:12b

# Downloadable offline release defaults
ASTRA_VERSION=1.0.0
ASTRA_PORT=8080
MODEL_PROVIDER=stub
CORTEX_LLM_PROVIDERS=stub
ASTRA_API_IMAGE=ghcr.io/astra-ssj/astra-grc-ce-api:v1.0.0
ASTRA_FRONTEND_IMAGE=ghcr.io/astra-ssj/astra-grc-ce-frontend:v1.0.0
POSTGRES_IMAGE=postgres:16-alpine
ASTRA_DATA_VOLUME=astra_grc_ce_postgres_data
