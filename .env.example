# ─────────────────────────────────────────────
# CORTEX Environment Variables
# Copy to .env and update before running
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_PASSWORD=cortex-dev
POSTGRES_USER=cortex
POSTGRES_DB=cortex

# FastAPI
JWT_SECRET=change-this-minimum-32-chars-random
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# REQUIRED — the stack refuses to start without these (docker-compose uses :?).
# No insecure defaults are baked in: set your own values here for local dev and
# always override in staging/production. Do NOT commit real values (.env is gitignored).
# ─────────────────────────────────────────────
CORTEX_LEGACY_DEMO_PASSWORD=change-me-local-demo
COMPLIANCE_ENGINE_STUB_PASSWORD=change-me-local-stub
COMPLIANCE_ENGINE_STUB_ACCESS_TOKEN=change-me-local-stub-token

# GraphJin
GO_ENV=development

# Optional: Anthropic API (Epic 4 — DSPy)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Production overrides
# DATABASE_URL=postgresql+asyncpg://cortex:password@db:5432/cortex
# API_HOST=0.0.0.0
# API_PORT=8000

# Frontend (Vite) — optional; use frontend/.env.local when running npm run dev
# Shows a deployment badge in the app shell (e.g. staging, prod-canary).
# VITE_CORTEX_DEPLOY_LABEL=staging
